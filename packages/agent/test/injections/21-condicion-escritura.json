              "args": {
                "type": {
                  "lit": "tarea"
                },
                "values": {
                  "fn": "obj",
                  "args": [
                    {
                      "lit": "titulo"
                    },
                    {
                      "quote": "revisar facturas"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "reader": {
    "choice": "tarea"
  },
  "expect": {
