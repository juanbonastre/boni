                    {
                      "lit": "titulo"
                    },
                    {
                      "ref": "$m.items[0].asunto"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "expect": {
    "errors": [null],
    "proposalsAtLeast": 1
  }
