              }
            }
          ]
        }
      ]
    },
    {
      "request": "gracias, ¿algo más?",
      "plans": [
        {
          "version": 1,
          "steps": [
            {
              "id": "r",
              "op": "reply",
              "component": "text",
              "data": {
                "template": {
                  "lit": "nada"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "expect": {
    "errors": [null, null]
  }
