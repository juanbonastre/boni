      "plans": [
        {
          "version": 1,
          "steps": [
            {
              "id": "m",
              "op": "call",
              "tool": "entities.query",
              "args": {
                "type": {
                  "lit": "correo"
                }
              }
            },
            {
              "id": "r",
              "op": "reply",
              "component": "text",
              "data": {
                "template": {
                  "ref": "$m.items[0].cuerpo"
