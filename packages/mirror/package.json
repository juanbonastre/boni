{
  "name": "@boni/mirror",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The Markdown mirror of the core in the vault (an edge, docs/nucleo.md 9.2 and 9.4): notes written from entities, hand edits back as proposals",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@boni/agent": "workspace:*",
    "@boni/calendar": "workspace:*",
    "@boni/entities": "workspace:*",
    "@boni/store": "workspace:*",
    "@boni/vault-import": "workspace:*",
    "@boni/views": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "vitest": "5.0.4"
  }
}
