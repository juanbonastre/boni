{
  "name": "boni-calendar",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm --filter @boni-calendar/web dev",
    "build": "pnpm --filter @boni-calendar/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2"
  }
}
