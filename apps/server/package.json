{
  "name": "@boni/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Boni's server: one account per person with its own store, the APIs of Boni, Boni Calendar and the agent, and Boni's MCP",
  "scripts": {
    "start": "node src/main.ts",
    "cli": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@boni/agent": "workspace:*",
    "@boni/calendar": "workspace:*",
    "@boni/calendar-web": "workspace:*",
    "@boni/entities": "workspace:*",
    "@boni/export": "workspace:*",
    "@boni/extensions": "workspace:*",
    "@boni/identity": "workspace:*",
    "@boni/mail": "workspace:*",
    "@boni/net": "workspace:*",
    "@boni/sandbox": "workspace:*",
    "@boni/store": "workspace:*",
    "@boni/views": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "vitest": "5.0.4"
  }
}
